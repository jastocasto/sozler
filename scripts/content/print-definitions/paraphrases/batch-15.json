{"düşhadüş": {"az": "Bir çox şeyin ardıcıl və kütləvi şəkildə yerə enməsi.", "en": "mass or successive falling", "pos": "noun", "src": "izahli", "conf": "high"}, "düşkünləşmək": {"az": "Gücdən düşüb zəifləmək, əvvəlki halını itirmək.", "en": "to become weak or decrepit", "pos": "verb", "src": "izahli", "conf": "high"}, "düşmə": {"az": "Bir şeyin yuxarıdan aşağı enməsi, yıxılması.", "en": "falling; the act of dropping", "pos": "noun", "src": "izahli", "conf": "high"}, "düşməli": {"az": "Qalmaq, yerləşmək üçün əlverişli olan (yer).", "en": "suitable for stopping or lodging at", "pos": "adjective", "src": "izahli", "conf": "low"}, "düşüb-qalmaq": {"az": "Bir yerdə uzun müddət ləngiyib qalmaq.", "en": "to stay somewhere for a long time", "pos": "verb", "src": "musayev", "conf": "high"}, "düşüklük": {"az": "Sallanmış, zəif və ya dəyəri aşağı olma vəziyyəti.", "en": "lowness or poor quality; ineptness", "pos": "noun", "src": "both", "conf": "low"}, "düşüm": {"az": "Bir şeyin yerinə yaxşı uyması, yaraşması.", "en": "suitability or becomingness", "pos": "noun", "src": "izahli", "conf": "high"}, "düşümlü": {"az": "Yerinə yaxşı uyan, yaraşan.", "en": "fitting or becoming", "pos": "adjective", "src": "izahli", "conf": "high"}, "düşümlülük": {"az": "Bir şeyin yerinə və ya kiməsə yaxşı uyma halı.", "en": "fittingness or becomingness", "pos": "noun", "src": "izahli", "conf": "high"}, "düşümsüz": {"az": "Yerinə uymayan, yaraşmayan.", "en": "unfitting or unbecoming", "pos": "adjective", "src": "izahli", "conf": "high"}, "düşümsüzlük": {"az": "Bir şeyin uyğun gəlməməsi, yaraşmaması halı.", "en": "unsuitability or unbecomingness", "pos": "noun", "src": "izahli", "conf": "high"}, "düşüncəlilik": {"az": "Ağıllı, dərrakəli və fərasətli olma keyfiyyəti.", "en": "thoughtfulness or good sense", "pos": "noun", "src": "both", "conf": "high"}, "düşüncəsizlik": {"az": "Ağılla, fikirləşərək hərəkət etməmə halı.", "en": "thoughtlessness", "pos": "noun", "src": "both", "conf": "high"}, "düşünə-dü